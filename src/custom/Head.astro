---
import "katex/dist/katex.min.css";

// Rendered in <head> on every page, after the theme's own tags. Add
// your own tags here: analytics, site verification, extra <meta> or
// <link>, stylesheets. This file is yours: AstroPaper never changes it
// after release.
type Props = {
  title: string;
  description: string;
};
---

<style is:global>
  /* 公式跟随主题颜色；长公式在自身区域滚动，避免撑宽手机页面。 */
  .app-prose .katex {
    color: var(--foreground);
  }

  .app-prose .katex-display {
    max-width: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    padding-block: 0.25rem;
    color: var(--foreground);
  }

  .app-prose .katex-display > .katex {
    width: max-content;
    min-width: 100%;
  }
</style>
