---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import PostList from "@/components/PostList.astro";
import { postFilter } from "@/utils/postFilter";
import { getPostFolder } from "@/utils/getPostFolder";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

// 只取 src/content/posts/notes/ 下的文章
const posts = (await getCollection("posts"))
  .filter(postFilter)
  .filter(post => getPostFolder(post) === "notes");
---

<Layout title={`${t.nav.notes} | ${config.site.title}`}>
  <Header />

  <Breadcrumb />

  <Main pageTitle={t.nav.notes}>
    <PostList {posts} />
  </Main>

  <Footer />
</Layout>
