---
import type { CollectionEntry } from "astro:content";
import { getPostUrl } from "@/utils/getPostPaths";
import { getPostDate } from "@/utils/getPostDate";
import { toTransitionName } from "@/utils/toTransitionName";
import config from "@/config";

type Props = {
  posts: CollectionEntry<"posts">[];
};

const { posts } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;

const sortedPosts = [...posts].sort(
  (a, b) => getPostDate(b).valueOf() - getPostDate(a).valueOf()
);

// 按年份分组，年份从新到旧
const postsByYear = new Map<string, CollectionEntry<"posts">[]>();
for (const post of sortedPosts) {
  const year = getPostDate(post).format("YYYY");
  const group = postsByYear.get(year);
  if (group) {
    group.push(post);
  } else {
    postsByYear.set(year, [post]);
  }
}

const yearGroups = [...postsByYear.entries()].sort(
  ([yearA], [yearB]) => Number(yearB) - Number(yearA)
);
---

<div class="space-y-10">
  {
    yearGroups.length === 0 && (
      <p class="text-muted-foreground">还没有文章。</p>
    )
  }
  {
    yearGroups.map(([year, yearPosts]) => (
      <div>
        <h3 class="text-muted-foreground flex items-baseline gap-2 text-lg font-semibold">
          {year}
          <sup class="text-xs font-normal">{yearPosts.length}</sup>
        </h3>

        <ul class="mt-4 space-y-4">
          {yearPosts.map(post => (
            <li class="flex items-baseline gap-3 sm:gap-6">
              <time
                class="text-muted-foreground w-20 shrink-0 text-sm tabular-nums sm:w-24"
                datetime={getPostDate(post).toISOString()}
              >
                {getPostDate(post).format("YYYY-MM-DD")}
              </time>
              <a
                href={getPostUrl(post.id, post.filePath, locale)}
                transition:name={toTransitionName(post.id)}
                class="text-accent min-w-0 flex-1 text-lg font-medium wrap-break-word decoration-dashed underline-offset-4 hover:underline"
              >
                {post.data.title}
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))
  }
</div>
